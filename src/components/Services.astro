---
import Icons from './Icons.astro';
import { getDictionary, getServices, type Locale } from '../utils/i18n';
import { getUpcomingFeasts } from '../utils/calendar';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const services = getServices(lang);
const upcomingFeasts = getUpcomingFeasts();
---

<section id="services" class="scroll-mt-24 sm:scroll-mt-28 py-14 sm:py-20 bg-church-cream border-b border-church-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-3xl mx-auto text-center space-y-4">
      <h2 class="font-serif text-3xl sm:text-4xl font-extrabold text-church-burgundy tracking-tight">
        {dict.services.title}
      </h2>
      <p class="text-xl text-church-muted">
        {dict.services.subtitle}
      </p>
    </div>

    <!-- Regular Service Schedule Grid/List (TIME-1, TIME-3) -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {services.regularServices.map((service) => {
        const feastDay = service.id === 'feast-saint-george' ? 23 : service.id === 'feast-saint-mary' ? 16 : null;
        const upcomingInfo = feastDay ? upcomingFeasts[feastDay] : null;

        return (
          <article class="bg-white rounded-2xl p-6 sm:p-8 border border-church-border shadow-xs hover:border-church-gold/60 transition-all flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex items-start justify-between gap-4 border-b border-church-border/70 pb-3">
                <span class="inline-block px-3 py-1 rounded-md bg-church-burgundy/10 text-church-burgundy font-bold text-sm sm:text-base">
                  {service.day}
                </span>
                <span class="text-base sm:text-lg font-extrabold text-church-gold-dark text-right">
                  {service.time}
                </span>
              </div>

              <h3 class="font-serif text-2xl font-bold text-church-burgundy">
                {service.title}
              </h3>

              <p class="text-church-charcoal text-base sm:text-lg leading-relaxed">
                {service.description}
              </p>

              {upcomingInfo && (
                <div class="mt-3 p-3 rounded-lg bg-amber-50/80 border border-amber-200/60 text-sm sm:text-base text-amber-950 flex items-center gap-2">
                  <Icons name="calendar" className="w-4 h-4 text-amber-800 shrink-0" />
                  <span>
                    <strong>{dict.services.upcomingCommemoration || 'Next Date:'}</strong>{' '}
                    {lang === 'am' ? upcomingInfo.formattedDateAm : upcomingInfo.formattedDateEn}
                  </span>
                </div>
              )}
            </div>

            <div class="pt-3 border-t border-church-border/50 text-xs sm:text-sm text-church-muted flex items-center gap-2">
              <Icons name="clock" className="w-4 h-4 text-church-gold shrink-0" />
              <span>{dict.services.tableTime}</span>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Ethiopian Calendar Guidance Note (TIME-3) -->
    <div class="mt-10 max-w-4xl mx-auto bg-amber-50/70 rounded-xl p-5 border border-amber-200/80 text-amber-950 flex items-start gap-4">
      <div class="text-amber-800 shrink-0 mt-0.5">
        <Icons name="calendar" className="w-6 h-6 text-amber-800" />
      </div>
      <div class="text-base sm:text-lg">
        <p class="font-bold text-amber-900 mb-1">
          {lang === 'am' ? 'የዘመን አቆጣጠር ማስታወሻ' : 'Calendar & Holy Feasts Note'}
        </p>
        <p class="text-amber-950 leading-relaxed">
          {services.calendarNote}
        </p>
      </div>
    </div>

  </div>
</section>
