    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    width={size}
    height={size}
    aria-hidden="true"
    focusable="false"
  >
    <rect x="4" y="3" width="16" height="15" rx="2" />
    <path d="M4 10h16" />
    <circle cx="8" cy="15" r="1.5" fill="currentColor" />
    <circle cx="16" cy="15" r="1.5" fill="currentColor" />
    <path d="M6 18v2" />
    <path d="M18 18v2" />
    <path d="M9 6h6" />
