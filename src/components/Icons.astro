---
interface Props {
  name:
    | 'cross'
    | 'train'
    | 'bus'
    | 'wheelchair'
    | 'restroom'
    | 'parking'
    | 'mappin'
    | 'check'
    | 'alert'
    | 'phone'
    | 'mail'
    | 'copy'
    | 'clock'
    | 'calendar'
    | 'chalice'
    | 'external';
  className?: string;
  size?: number;
}

const { name, className = 'w-5 h-5', size = 20 } = Astro.props;
---

{name === 'cross' && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="currentColor"
    class={className}
    width={size}
    height={size}
    aria-hidden="true"
    focusable="false"
  >
    <!-- Ethiopian Orthodox cross icon -->
    <path d="M11 2h2v4h4v2h-4v3h3v2h-3v7h-2v-7H8v-2h3V8H7V6h4V2z" />
    <path d="M10 1h4v2h-4zM10 21h4v2h-4zM5 7h2v4H5zM17 7h2v4h-2z" opacity="0.7" />
  </svg>
)}

{name === 'train' && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    width={size}
    height={size}
    aria-hidden="true"
    focusable="false"
  >
    <rect x="4" y="3" width="16" height="15" rx="3" />
    <path d="M4 11h16" />
    <path d="M8 7h.01" />
    <path d="M16 7h.01" />
    <path d="M7 18l-3 4" />
    <path d="M17 18l3 4" />
    <circle cx="8" cy="15" r="1" fill="currentColor" />
    <circle cx="16" cy="15" r="1" fill="currentColor" />
  </svg>
)}

