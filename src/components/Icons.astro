    focusable="false"
  >
    <circle cx="12" cy="4" r="2" />
    <path d="M12 6v7h5" />
    <path d="M9 13a5 5 0 1 0 5 5" />
    <path d="M14 18h4" />
  </svg>
)}

{name === 'restroom' && (
