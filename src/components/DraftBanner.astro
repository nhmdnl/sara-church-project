---
import { type Locale } from '../utils/i18n';
import Icons from './Icons.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<aside
  class="bg-red-50 border-b-2 border-red-500 text-red-950 px-4 py-3 sm:px-6 shadow-sm relative z-50 print:border-red-600"
  role="alert"
  aria-label={lang === 'am' ? 'የቅድመ-እይታ ሰሌዳ ማስታወሻ' : 'Development Preview Notice'}
>
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-3 text-sm sm:text-base">
    <div class="flex items-start sm:items-center gap-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-700 text-white font-extrabold text-xs uppercase tracking-wider shrink-0 shadow-xs">
        <Icons name="alert" className="w-3.5 h-3.5" />
        <span>{lang === 'am' ? 'ቅድመ-እይታ' : 'PREVIEW'}</span>
      </span>
      <p class="font-medium text-red-950 leading-snug">
        {lang === 'am' ? (
          <>
            <strong>የድረ-ገጽ ቅድመ-እይታ (Preview):</strong> ይህ ገጽ ወደፊት የሚኖረውን ይዘትና ገጽታ የሚያሳይ የሙከራ ቅድመ-እይታ ነው። ያልተረጋገጡ ጊዜያዊ መረጃዎች (የቦታ አድራሻ፣ የአገልግሎት ሰዓታት እና የተደራሽነት መረጃዎች) ይፋዊ ማረጋገጫ የሚሹ በመሆናቸው <span class="inline-block px-1.5 py-0.2 bg-red-200 text-red-900 border border-red-400 rounded font-bold">በቀይ ቀለም ተለይተው (red highlight)</span> ተቀምጠዋል።
          </>
        ) : (
          <>
            <strong>Development Preview:</strong> This is a preview of what the page is supposed to be. Unverified provisional details (venue address, service schedule, accessibility &amp; parking) are placeholders awaiting formal clergy/trustee sign-off, highlighted with a <span class="inline-block px-1.5 py-0.2 bg-red-200 text-red-900 border border-red-400 rounded font-bold">red highlight</span>.
          </>
        )}
      </p>
    </div>
  </div>
</aside>
