---
import Icons from './Icons.astro';
import { getDictionary, getChurch, type Locale, getLocalizedUrl } from '../utils/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const church = getChurch(lang);
const privacyUrl = getLocalizedUrl('/privacy', lang);
---

<section id="contact" class="scroll-mt-24 sm:scroll-mt-28 py-14 sm:py-20 bg-church-cream border-b border-church-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-3xl mx-auto text-center space-y-4">
      <h2 class="font-serif text-3xl sm:text-4xl font-extrabold text-church-burgundy tracking-tight">
        {dict.contact.title}
      </h2>
      <p class="text-xl text-church-muted">
        {dict.contact.subtitle}
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Direct Contact Channels (CONT-1, CONT-3) -->
      <div class="lg:col-span-5 space-y-6">
        
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-church-border shadow-xs space-y-6">
          <h3 class="font-serif text-2xl font-bold text-church-burgundy">
            {dict.contact.telephone} &amp; {dict.contact.email}
          </h3>

          <div class="space-y-4">
            
            <!-- Tappable Phone (CONT-1) -->
            <div class="flex items-start gap-4 p-4 rounded-xl bg-church-cream/60 border border-church-border/70">
              <div class="w-10 h-10 rounded-full bg-church-burgundy/10 text-church-burgundy flex items-center justify-center shrink-0 mt-0.5">
                <Icons name="phone" className="w-5 h-5 text-church-burgundy" />
              </div>
              <div class="space-y-1 min-w-0 flex-1">
                <span class="text-xs font-bold text-church-gold-dark uppercase tracking-wider block">
                  {dict.contact.telephone}
                </span>
                <a
                  href={`tel:${church.contact.phone}`}
                  class="text-lg sm:text-xl font-bold text-church-burgundy hover:underline break-all touch-target max-w-full"
                >
                  {church.contact.phoneDisplay}
                </a>
                <p class="text-xs text-church-muted">
                  {church.contact.officeHours}
                </p>
              </div>
            </div>

            <!-- Tappable Email (CONT-1) -->
            <div class="flex items-start gap-4 p-4 rounded-xl bg-church-cream/60 border border-church-border/70">
              <div class="w-10 h-10 rounded-full bg-church-burgundy/10 text-church-burgundy flex items-center justify-center shrink-0 mt-0.5">
                <Icons name="mail" className="w-5 h-5 text-church-burgundy" />
              </div>
              <div class="space-y-1 min-w-0 flex-1">
                <span class="text-xs font-bold text-church-gold-dark uppercase tracking-wider block">
                  {dict.contact.email}
                </span>
                <a
                  href={`mailto:${church.contact.email}`}
                  class="text-lg sm:text-xl font-bold text-church-burgundy hover:underline break-all touch-target"
                >
                  {church.contact.email}
                </a>
                <p class="text-xs text-church-muted">
                  {lang === 'am' ? 'ለአጠቃላይ ጥያቄዎች እና መንፈሳዊ አገልግሎቶች' : 'Monitored by designated parish stewards'}
                </p>
              </div>
            </div>

          </div>

          <!-- Official Registered Office Address -->
          <div class="pt-4 border-t border-church-border/60 space-y-1">
            <h4 class="text-xs font-bold uppercase tracking-wider text-church-gold-dark">
              {lang === 'am' ? 'የተመዘገበ የቢሮ አድራሻ (Registered Office)' : 'Registered Charity Office'}
            </h4>
            <p class="text-sm text-church-charcoal font-medium">
              {church.charity.registeredOffice.line1}, {church.charity.registeredOffice.line2}, {church.charity.registeredOffice.city} {church.charity.registeredOffice.postcode}
            </p>
            <p class="text-xs text-church-muted">
              {lang === 'am' ? 'የበጎ አድራጎት ቁጥር፡' : 'Charity Commission Registration No:'} <strong>{church.charity.number}</strong>
            </p>
          </div>

          <!-- Official Social Channels (CONT-3) -->
          <div class="pt-4 border-t border-church-border/60">
            <h4 class="text-xs font-bold uppercase tracking-wider text-church-muted mb-2">
              {lang === 'am' ? 'ይፋዊ ማኅበራዊ ገጾች' : 'Official Channels'}
            </h4>
            <p class="text-sm text-church-muted">
              {lang === 'am' ? 'ይፋዊ የማኅበራዊ ገጽ አድራሻዎች በአስተዳዳሪዎች ማረጋገጫ ሲያገኙ ይፋ ይደረጋሉ።' : 'Official parish announcement channels will be published upon trustee verification.'}
            </p>
          </div>

        </div>

      </div>

      <!-- Accessible Contact Form (CONT-2) -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-church-border shadow-xs">
          <h3 class="font-serif text-2xl font-bold text-church-burgundy mb-2">
            {dict.contact.formHeading}
          </h3>
          <p class="text-base text-church-muted mb-6">
            {lang === 'am' ? 'ጥያቄዎን ወይም አስተያየትዎን ከዚህ በታች ባለው ቅጽ ይላኩልን።' : 'Send a message directly to our parish trustees and clergy.'}
          </p>

          <form id="parish-contact-form" class="space-y-5" method="POST" action="/api/contact" novalidate>
            
            <!-- Anti-spam Honeypot (CONT-2) -->
            <div class="hidden" aria-hidden="true">
              <label for="honeypot-website">Do not fill this field</label>
              <input type="text" id="honeypot-website" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <!-- Name Input -->
            <div class="space-y-2">
              <label for="contact-name" class="block text-base font-bold text-church-charcoal">
                {dict.contact.nameLabel} <span class="text-church-burgundy" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                autocomplete="name"
                placeholder={dict.contact.namePlaceholder}
                class="w-full px-4 py-3 rounded-xl border border-church-border bg-church-cream/30 text-church-charcoal text-base focus:border-church-gold focus:ring-2 focus:ring-church-gold/20 focus:outline-none transition-colors"
              />
              <p id="contact-name-error" class="hidden text-sm font-semibold text-red-700" role="alert">
                {lang === 'am' ? 'እባክዎ ስምዎን ያስገቡ።' : 'Please enter your name.'}
              </p>
            </div>

            <!-- Email Input -->
            <div class="space-y-2">
              <label for="contact-email" class="block text-base font-bold text-church-charcoal">
                {dict.contact.emailLabel} <span class="text-church-burgundy" aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                autocomplete="email"
                placeholder={dict.contact.emailPlaceholder}
                class="w-full px-4 py-3 rounded-xl border border-church-border bg-church-cream/30 text-church-charcoal text-base focus:border-church-gold focus:ring-2 focus:ring-church-gold/20 focus:outline-none transition-colors"
              />
              <p id="contact-email-error" class="hidden text-sm font-semibold text-red-700" role="alert">
                {lang === 'am' ? 'እባክዎ ትክክለኛ የኢሜይል አድራሻ ያስገቡ።' : 'Please enter a valid email address.'}
              </p>
            </div>

            <!-- Message Textarea -->
            <div class="space-y-2">
              <label for="contact-message" class="block text-base font-bold text-church-charcoal">
                {dict.contact.messageLabel} <span class="text-church-burgundy" aria-hidden="true">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                required
                rows="4"
                placeholder={dict.contact.messagePlaceholder}
                class="w-full px-4 py-3 rounded-xl border border-church-border bg-church-cream/30 text-church-charcoal text-base focus:border-church-gold focus:ring-2 focus:ring-church-gold/20 focus:outline-none transition-colors"
              ></textarea>
              <p id="contact-message-error" class="hidden text-sm font-semibold text-red-700" role="alert">
                {lang === 'am' ? 'እባክዎ መልእክትዎን ያስገቡ።' : 'Please enter your message.'}
              </p>
            </div>

            <!-- Privacy Consent Statement (CONT-2, LEGAL-2) -->
            <div class="text-sm text-church-muted leading-relaxed">
              <span>{dict.contact.privacyNoticeText} </span>
              <a href={privacyUrl} class="text-church-burgundy font-bold underline hover:text-church-burgundy-light">
                {dict.contact.privacyNoticeLink}
              </a>.
            </div>

            <!-- Submit Button (CONT-2): High-contrast solid button, enabled by default -->
            <button
              type="submit"
              id="submit-form-btn"
              class="touch-target w-full sm:w-auto px-8 py-3.5 rounded-xl bg-church-burgundy text-white hover:bg-church-burgundy-light font-bold text-lg shadow-sm transition-all focus-visible:outline-church-gold border-2 border-church-burgundy"
            >
              {dict.contact.submitButton}
            </button>

            <!-- Feedback Alert Banners -->
            <div id="form-success-alert" class="hidden p-4 rounded-xl bg-emerald-50 border-2 border-emerald-300 text-emerald-950 text-base font-semibold" role="alert">
              ✓ {dict.contact.successMessage}
            </div>

            <div id="form-error-alert" class="hidden p-4 rounded-xl bg-red-50 border-2 border-red-300 text-red-950 text-base font-semibold" role="alert">
              ⚠ {lang === 'am' ? 'እባክዎ ሁሉንም መስኮች በትክክል መሙላትዎን ያረጋግጡ።' : 'Please check the required fields and try submitting again.'}
            </div>

          </form>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // Form submission handler with anti-spam check and accessible validation feedback
  const form = document.getElementById('parish-contact-form') as HTMLFormElement | null;
  const successAlert = document.getElementById('form-success-alert');
  const errorAlert = document.getElementById('form-error-alert');
  const submitBtn = document.getElementById('submit-form-btn');

  const fields = [
    {
      input: document.getElementById('contact-name') as HTMLInputElement | null,
      error: document.getElementById('contact-name-error'),
    },
    {
      input: document.getElementById('contact-email') as HTMLInputElement | null,
      error: document.getElementById('contact-email-error'),
    },
    {
      input: document.getElementById('contact-message') as HTMLTextAreaElement | null,
      error: document.getElementById('contact-message-error'),
    },
  ];

  function validateField(item: { input: HTMLElement | null; error: HTMLElement | null }): boolean {
    const input = item.input as HTMLInputElement | HTMLTextAreaElement | null;
    if (!input) return true;
    const isValid = input.checkValidity();
    if (!isValid) {
      input.setAttribute('aria-invalid', 'true');
      if (item.error) {
        input.setAttribute('aria-describedby', item.error.id);
        item.error.classList.remove('hidden');
      }
      input.classList.add('border-red-500', 'focus:border-red-500', 'focus:ring-red-200');
    } else {
      input.removeAttribute('aria-invalid');
      if (item.error) {
        input.removeAttribute('aria-describedby');
        item.error.classList.add('hidden');
      }
      input.classList.remove('border-red-500', 'focus:border-red-500', 'focus:ring-red-200');
    }
    return isValid;
  }

  // Real-time validation: clear error and aria-invalid on input once valid
  fields.forEach((item) => {
    item.input?.addEventListener('input', () => {
      if (item.input?.getAttribute('aria-invalid') === 'true') {
        validateField(item);
      }
    });
  });

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const honeypot = (document.getElementById('honeypot-website') as HTMLInputElement)?.value;
      if (honeypot) {
        // Silently reject bot submissions
        return;
      }

      let allValid = true;
      let firstInvalidInput: HTMLElement | null = null;

      fields.forEach((item) => {
        const valid = validateField(item);
        if (!valid) {
          allValid = false;
          if (!firstInvalidInput && item.input) {
            firstInvalidInput = item.input;
          }
        }
      });

      if (allValid) {
        errorAlert?.classList.add('hidden');
        if (submitBtn) {
          submitBtn.setAttribute('disabled', 'true');
          submitBtn.classList.add('opacity-75');
        }

        // Simulate successful delivery to church mailbox
        setTimeout(() => {
          form.reset();
          fields.forEach((item) => {
            item.input?.removeAttribute('aria-invalid');
            item.input?.removeAttribute('aria-describedby');
            item.error?.classList.add('hidden');
            item.input?.classList.remove('border-red-500', 'focus:border-red-500', 'focus:ring-red-200');
          });
          successAlert?.classList.remove('hidden');
          errorAlert?.classList.add('hidden');
          if (submitBtn) {
            submitBtn.removeAttribute('disabled');
            submitBtn.classList.remove('opacity-75');
          }
        }, 500);
      } else {
        errorAlert?.classList.remove('hidden');
        successAlert?.classList.add('hidden');
        firstInvalidInput?.focus();
      }
    });
  }
</script>
