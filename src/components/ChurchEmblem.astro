---
interface Props {
  className?: string;
  size?: number;
}

const { className = "w-10 h-10", size = 40 } = Astro.props;
---

<img
  src="/church-logo.svg"
  alt="Felege Genet Sema'etu Kidus Giorgis Church Emblem"
  width={size}
  height={size}
  class={`object-contain select-none pointer-events-none ${className}`}
  loading="eager"
  decoding="async"
/>
