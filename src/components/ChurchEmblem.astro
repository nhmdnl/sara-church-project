---
interface Props {
  className?: string;
  size?: number;
}

const { className = 'w-10 h-10', size = 40 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  fill="none"
  class={className}
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <!-- Ethiopian Orthodox decorative cross emblem (Lalibela style motif) -->
  <circle cx="50" cy="50" r="46" stroke="currentColor" stroke-width="2.5" opacity="0.85" />
  <circle cx="50" cy="50" r="42" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3" opacity="0.6" />
  
  <!-- Central cross vertical arm -->
  <path
    d="M47 16 H53 V38 H64 V33 H69 V43 H64 V47 H84 V43 H89 V57 H84 V53 H64 V57 H69 V67 H64 V62 H53 V84 H58 V89 H42 V84 H47 V62 H36 V67 H31 V57 H36 V53 H16 V57 H11 V43 H16 V47 H36 V43 H31 V33 H36 V38 H47 Z"
    fill="currentColor"
    opacity="0.95"
  />

  <!-- Interlocking geometric trefoil cross highlights -->
  <rect x="46" y="10" width="8" height="6" rx="2" fill="currentColor" />
  <rect x="46" y="84" width="8" height="6" rx="2" fill="currentColor" />
  <rect x="10" y="46" width="6" height="8" rx="2" fill="currentColor" />
  <rect x="84" y="46" width="6" height="8" rx="2" fill="currentColor" />
  
  <circle cx="50" cy="50" r="4" fill="#faf7f2" />
</svg>
