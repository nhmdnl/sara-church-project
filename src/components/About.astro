---
import ChurchEmblem from './ChurchEmblem.astro';
import Icons from './Icons.astro';
import { getDictionary, getChurch, type Locale } from '../utils/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const church = getChurch(lang);
---

<section id="about" class="scroll-mt-24 sm:scroll-mt-28 py-14 sm:py-20 bg-white border-b border-church-border">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center space-y-4">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-full overflow-hidden bg-white border border-church-gold/40 mx-auto shadow-xs">
        <ChurchEmblem className="w-full h-full p-1" />
      </div>

      <h2 class="font-serif text-3xl sm:text-4xl font-extrabold text-church-burgundy tracking-tight">
        {dict.about.title}
      </h2>
      <p class="text-xl font-medium text-church-gold-dark max-w-2xl mx-auto">
        {dict.about.subtitle}
      </p>
    </div>

    <!-- About us narrative (HOME-3): strictly left-aligned for optimal reading comfort -->
    <div class="mt-8 space-y-6 text-church-charcoal text-lg sm:text-xl leading-relaxed text-left bg-church-cream/40 p-6 sm:p-8 rounded-2xl border border-church-border/80 shadow-xs">
      <p>
        {dict.about.body1}
      </p>
      <p>
        {dict.about.body2}
      </p>

      <!-- Charitable Activities & Registered Status -->
      <div class="mt-4 p-4 rounded-xl bg-white border border-church-border/80 space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-church-border/60 pb-2">
          <span class="text-xs uppercase font-bold tracking-wider text-church-burgundy">
            {lang === 'am' ? 'የበጎ አድራጎት ተግባራት እና ዓላማ' : 'Charitable Activities & Objects'}
          </span>
          <span class="text-xs font-semibold text-church-gold-dark bg-church-cream px-2 py-0.5 rounded border border-church-gold/30">
            {lang === 'am' ? 'የተመዘገበ በጎ አድራጎት ቁጥር' : 'Charity Commission No.'}: {church.charity.number}
          </span>
        </div>
        <p class="text-sm sm:text-base text-church-charcoal leading-relaxed">
          {church.charity.activities}
        </p>

        <!-- Board of Trustees -->
        <div class="pt-2">
          <h4 class="text-xs font-bold uppercase tracking-wider text-church-muted mb-2">
            {lang === 'am' ? 'የአስተዳደር ቦርድ (Board of Trustees)' : 'Board of Trustees & Leadership'}
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
            {church.charity.trustees.map((t) => (
              <div class="bg-church-cream/50 p-2.5 rounded-lg border border-church-border/50 text-xs sm:text-sm">
                <strong class="text-church-burgundy block font-semibold">{t.name}</strong>
                <span class="text-church-muted">{t.role}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="pt-4 border-t border-church-border/60 flex flex-wrap items-center justify-between gap-4 text-sm sm:text-base text-church-muted">
        <span class="font-semibold text-church-burgundy inline-flex items-center gap-1.5">
          <Icons name="cross" className="w-4 h-4 text-church-gold" />
          <span>{church.tradition}</span>
        </span>
        <span class="italic">
          {church.dedication}
        </span>
      </div>
    </div>

  </div>
</section>
