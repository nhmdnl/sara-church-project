---
import ChurchEmblem from './ChurchEmblem.astro';
import Icons from './Icons.astro';
import { getDictionary, getChurch, getVenue, type Locale, getLocalizedUrl } from '../utils/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const church = getChurch(lang);
const venue = getVenue(lang);
const privacyUrl = getLocalizedUrl('/privacy', lang);
const accessibilityUrl = getLocalizedUrl('/accessibility', lang);
---

<footer class="bg-church-burgundy-dark text-white pt-12 pb-16 border-t-4 border-church-gold print:border-church-gold">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      
      <!-- Church Brand & Charity Statement (LEGAL-1) -->
      <div class="md:col-span-7 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full overflow-hidden bg-white flex items-center justify-center border border-church-gold/40 shrink-0 shadow-xs">
            <ChurchEmblem className="w-full h-full p-0.5" />
          </div>
          <div>
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-white">
              {church.name}
            </h3>
            <p class="text-xs sm:text-sm text-church-gold-light font-medium">
              {church.tradition}
            </p>
          </div>
        </div>

        <p class="text-sm sm:text-base text-stone-300 max-w-xl leading-relaxed">
          {church.dedication}
        </p>

        <!-- Worship Venue Address in Footer -->
        <p class="text-xs sm:text-sm text-stone-300 leading-relaxed flex items-center gap-2">
          <Icons name="mappin" className="w-4 h-4 text-church-gold shrink-0" />
          <span>{venue.name} — {venue.fullAddressString}</span>
        </p>

        <!-- Mandatory UK Charity Disclosure (LEGAL-1, Charities Act 2011 s.39) -->
        <div class="bg-black/40 rounded-xl p-4 border border-church-gold/30 space-y-1">
          <p class="text-sm font-semibold text-church-gold-light">
            {dict.footer.charityHeading}
          </p>
          <p class="text-sm text-stone-200 leading-relaxed">
            {church.charity.statement}
          </p>
          <p class="text-xs text-stone-300">
            Charity Name: <strong class="text-white">{church.charity.name}</strong>
          </p>
        </div>
      </div>

      <!-- Quick Links & Legal (LEGAL-2, LEGAL-3, LEGAL-4) -->
      <div class="md:col-span-5 space-y-4 md:text-right">
        <h4 class="text-xs uppercase font-bold tracking-widest text-church-gold-light">
          {dict.footer.quickLinks}
        </h4>
        <ul class="space-y-2 text-base">
          <li>
            <a href={privacyUrl} class="text-stone-200 hover:text-white underline-offset-4 hover:underline transition-colors touch-target">
              {dict.footer.privacyLink}
            </a>
          </li>
          <li>
            <a href={accessibilityUrl} class="text-stone-200 hover:text-white underline-offset-4 hover:underline transition-colors touch-target">
              {dict.footer.accessibilityLink}
            </a>
          </li>
          <li>
            <a href={`${getLocalizedUrl('/', lang)}#about`} class="text-stone-200 hover:text-white underline-offset-4 hover:underline transition-colors touch-target">
              {dict.nav.about}
            </a>
          </li>
          <li>
            <a href={`${getLocalizedUrl('/', lang)}#services`} class="text-stone-200 hover:text-white underline-offset-4 hover:underline transition-colors touch-target">
              {dict.nav.services}
            </a>
          </li>
          <li>
            <a href={`${getLocalizedUrl('/', lang)}#find-us`} class="text-stone-200 hover:text-white underline-offset-4 hover:underline transition-colors touch-target">
              {dict.nav.findUs}
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright Bar -->
    <div class="pt-6 border-t border-stone-700/60 flex flex-wrap items-center justify-between gap-4 text-xs sm:text-sm text-stone-300">
      <p>
        © {new Date().getFullYear()} {dict.footer.copyright}
      </p>
      <p>
        We aim to meet WCAG 2.2 AA standards.
      </p>
    </div>

  </div>
</footer>
