---
import { getDictionary, getVenue, type Locale } from '../utils/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const venue = getVenue(lang);
---

<section id="find-us" class="scroll-mt-24 sm:scroll-mt-28 py-14 sm:py-20 bg-white border-b border-church-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Section Heading -->
    <div class="max-w-3xl mx-auto text-center space-y-4">
      <h2 class="font-serif text-3xl sm:text-4xl font-extrabold text-church-burgundy tracking-tight">
        {dict.findUs.title}
      </h2>
      <p class="text-xl text-church-muted">
        {dict.findUs.subtitle}
      </p>
    </div>

    <!-- Location & Map Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Address & Directions Column (FIND-1, FIND-3, FIND-6) -->
      <div class="lg:col-span-5 space-y-6">
        
        <div class="bg-church-cream rounded-2xl p-6 sm:p-8 border border-church-border shadow-xs space-y-6">
          
          <div class="space-y-2">
            <span class="text-xs uppercase font-bold text-church-gold-dark tracking-wider">
              {dict.findUs.venueDetails}
            </span>
            <h3 class="font-serif text-2xl font-bold text-church-burgundy">
              {venue.name}
            </h3>
            {venue.hostBuilding && (
              <p class="text-base font-semibold text-church-gold-dark">
                📍 {venue.hostBuilding}
              </p>
            )}
          </div>

          <!-- Real Selectable Address (FIND-1) -->
          <div class="p-4 bg-white rounded-xl border border-church-border/80">
            <address id="venue-address-text" class="not-italic text-lg text-church-charcoal leading-relaxed font-medium">
              {venue.address.line1}<br />
              {venue.address.line2}<br />
              {venue.address.city}<br />
              <strong class="font-bold text-church-burgundy">{venue.address.postcode}</strong><br />
              {venue.address.country}
            </address>

            <div class="mt-4 pt-3 border-t border-church-border/60 flex items-center gap-3">
              <button
                type="button"
                id="copy-address-btn"
                class="touch-target px-3.5 py-2 rounded-lg bg-church-cream-alt hover:bg-church-border text-church-charcoal text-sm font-bold transition-colors flex items-center gap-2 focus-visible:outline-church-gold"
                aria-label={dict.findUs.copyAddress}
                data-address={venue.fullAddressString}
                data-copied-text={dict.findUs.copied}
                data-original-text={dict.findUs.copyAddress}
                data-live-copied={lang === 'am' ? 'አድራሻው ተቀድቷል' : 'Address copied to clipboard'}
              >
                <svg class="w-4 h-4 text-church-burgundy" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
                </svg>
                <span id="copy-btn-text">{dict.findUs.copyAddress}</span>
              </button>
              <span id="copy-status-live" class="sr-only" aria-live="polite" role="status"></span>
            </div>
          </div>

          <!-- Host Entrance Instructions (FIND-6) -->
          <div class="bg-amber-50/70 border border-amber-200 rounded-xl p-4 space-y-1">
            <h4 class="font-bold text-amber-950 text-base flex items-center gap-2">
              <svg class="w-5 h-5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>{dict.findUs.entranceTitle}</span>
            </h4>
            <p class="text-sm sm:text-base text-amber-900 leading-relaxed">
              {venue.entranceInstructions}
            </p>
          </div>

          <!-- Directions Buttons (FIND-3) -->
          <div class="space-y-3 pt-2">
            <a
              href={venue.directionsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="touch-target w-full py-3.5 px-4 rounded-xl bg-church-burgundy text-white hover:bg-church-burgundy-light font-bold text-base transition-colors flex items-center justify-center gap-2 shadow-xs"
            >
              <svg class="w-5 h-5 text-church-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span>{dict.findUs.openInGoogle}</span>
            </a>

            <a
              href={venue.appleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="touch-target w-full py-3 px-4 rounded-xl border border-church-border bg-white hover:bg-church-cream-alt text-church-charcoal font-bold text-base transition-colors flex items-center justify-center gap-2"
            >
              <span>{dict.findUs.openInApple}</span>
            </a>
          </div>

        </div>

      </div>

      <!-- Static Map Preview & On-Demand Interactive Map (FIND-2) -->
      <div class="lg:col-span-7">
        <div class="bg-church-cream rounded-2xl border border-church-border shadow-xs overflow-hidden">
          
          <div class="p-4 sm:p-5 bg-church-cream-alt border-b border-church-border flex flex-wrap items-center justify-between gap-3">
            <div>
              <h3 class="font-serif text-xl font-bold text-church-burgundy">
                {dict.findUs.interactiveMapTitle}
              </h3>
              <p class="text-xs sm:text-sm text-church-muted mt-0.5">
                {dict.findUs.mapNotice}
              </p>
            </div>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold">
              ✓ {dict.findUs.mapPrivacyBadge}
            </span>
          </div>

          <!-- Map Container -->
          <div id="map-container" class="relative w-full h-80 sm:h-96 bg-stone-100 flex items-center justify-center">
            
            <!-- Static Map Fallback (FIND-2) -->
            <div id="static-map-view" class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center bg-gradient-to-br from-stone-200 via-stone-100 to-amber-50">
              <svg class="w-16 h-16 text-church-burgundy animate-bounce mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <h4 class="text-lg font-bold text-church-charcoal">
                {venue.name}
              </h4>
              <p class="text-sm text-church-muted max-w-sm mt-1">
                {venue.fullAddressString}
              </p>

              <!-- On-demand loader button (FIND-2) -->
              <button
                type="button"
                id="load-interactive-map-btn"
                class="mt-4 touch-target px-5 py-2.5 rounded-lg bg-church-burgundy text-white hover:bg-church-burgundy-light font-bold text-base shadow-sm transition-colors flex items-center gap-2 focus-visible:outline-church-gold"
                aria-expanded="false"
                aria-controls="interactive-map-frame"
                data-loaded-announcement={dict.findUs.mapLoadedNotice}
              >
                <svg class="w-5 h-5 text-church-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
                </svg>
                <span>{dict.findUs.loadMapButton}</span>
              </button>
            </div>

            <!-- Dynamic map mount point (populated on user tap) -->
            <div id="interactive-map-frame" class="w-full h-full hidden" role="region" aria-label={dict.findUs.interactiveMapTitle}></div>
            <div id="map-status-live" class="sr-only" aria-live="polite" role="status"></div>

          </div>

        </div>

        <!-- Public Transport Guidance (FIND-4) -->
        <div class="mt-6 bg-white rounded-2xl p-6 sm:p-8 border border-church-border shadow-xs space-y-6">
          <h3 class="font-serif text-2xl font-bold text-church-burgundy">
            {dict.findUs.publicTransportTitle}
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            
            <!-- Stations -->
            <div class="space-y-3">
              <h4 class="font-bold text-church-charcoal text-base flex items-center gap-2">
                <span>🚆</span>
                <span>{dict.findUs.nearestStations}</span>
              </h4>
              <ul class="space-y-2">
                {venue.publicTransport.stations.map((st) => (
                  <li class="bg-church-cream/60 p-3 rounded-lg border border-church-border/50 text-sm sm:text-base">
                    <strong class="text-church-burgundy block font-semibold">{st.name}</strong>
                    <span class="text-church-muted">{st.distance}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Buses -->
            <div class="space-y-3">
              <h4 class="font-bold text-church-charcoal text-base flex items-center gap-2">
                <span>🚍</span>
                <span>{dict.findUs.busRoutesTitle}</span>
              </h4>
              <ul class="space-y-2">
                {venue.publicTransport.busRoutes.map((b) => (
                  <li class="bg-church-cream/60 p-3 rounded-lg border border-church-border/50 text-sm sm:text-base">
                    <span class="inline-block px-2 py-0.5 bg-church-burgundy text-white font-bold rounded text-xs mr-1">
                      {b.routes}
                    </span>
                    <strong class="text-church-charcoal">{b.stop}</strong>
                    <p class="text-church-muted text-xs sm:text-sm mt-0.5">{b.walkingTime}</p>
                  </li>
                ))}
              </ul>
            </div>

          </div>

          <div class="pt-2">
            <a
              href={venue.publicTransport.tflPlannerUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="touch-target min-h-[44px] min-w-[44px] inline-flex items-center gap-2 text-church-burgundy font-bold text-base hover:underline focus-visible:outline-church-gold"
            >
              <span>{dict.findUs.planJourneyTfl}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
            </a>
          </div>
        </div>

      </div>

    </div>

    <!-- Parking & Accessibility Details (FIND-5) -->
    <div class="bg-church-cream-alt/50 rounded-2xl p-6 sm:p-8 border border-church-border space-y-6">
      <h3 class="font-serif text-2xl font-bold text-church-burgundy">
        {dict.findUs.accessTitle}
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-5 rounded-xl border border-church-border/70 space-y-2">
          <div class="w-10 h-10 rounded-lg bg-church-cream flex items-center justify-center text-church-burgundy font-bold text-xl">
            ♿
          </div>
          <h4 class="font-bold text-church-charcoal text-lg">
            {lang === 'am' ? 'ደረጃ የሌለው መግቢያ' : 'Step-free Access'}
          </h4>
          <p class="text-sm sm:text-base text-church-muted leading-relaxed">
            {venue.accessibility.stepFree}
          </p>
        </div>

        <div class="bg-white p-5 rounded-xl border border-church-border/70 space-y-2">
          <div class="w-10 h-10 rounded-lg bg-church-cream flex items-center justify-center text-church-burgundy font-bold text-xl">
            🚻
          </div>
          <h4 class="font-bold text-church-charcoal text-lg">
            {lang === 'am' ? 'ተስማሚ መጸዳጃ' : 'Accessible Toilets'}
          </h4>
          <p class="text-sm sm:text-base text-church-muted leading-relaxed">
            {venue.accessibility.toilets}
          </p>
        </div>

        <div class="bg-white p-5 rounded-xl border border-church-border/70 space-y-2">
          <div class="w-10 h-10 rounded-lg bg-church-cream flex items-center justify-center text-church-burgundy font-bold text-xl">
            🅿️
          </div>
          <h4 class="font-bold text-church-charcoal text-lg">
            {lang === 'am' ? 'የመኪና ማቆሚያ' : 'Parking & Blue Badge'}
          </h4>
          <p class="text-sm sm:text-base text-church-muted leading-relaxed">
            {venue.accessibility.parking}
          </p>
        </div>
      </div>
    </div>

    <!-- "What to Expect on Your First Visit" (FIND-7) -->
    <div class="bg-white rounded-2xl p-6 sm:p-8 border border-church-border shadow-xs space-y-6">
      <div class="space-y-2">
        <h3 class="font-serif text-2xl sm:text-3xl font-bold text-church-burgundy">
          {dict.findUs.firstVisitTitle}
        </h3>
        <p class="text-base sm:text-lg text-church-muted">
          {lang === 'am' ? 'ለመጀመሪያ ጊዜ ለሚመጡ እንግዶች እና ምእመናን አጠቃላይ መመሪያ' : 'Guidance for first-time visitors, families, and guests attending our worship services.'}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-2">
        {venue.firstVisitGuide.map((item) => (
          <div class="bg-church-cream/50 p-5 rounded-xl border border-church-border/60 space-y-2">
            <h4 class="font-bold text-church-burgundy text-lg">
              {item.title}
            </h4>
            <p class="text-church-charcoal text-sm sm:text-base leading-relaxed">
              {item.detail}
            </p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  // Copy address to clipboard with dynamic aria-live feedback
  const copyBtn = document.getElementById('copy-address-btn');
  const copyBtnText = document.getElementById('copy-btn-text');
  const copyStatusLive = document.getElementById('copy-status-live');

  if (copyBtn && copyBtnText) {
    copyBtn.addEventListener('click', async () => {
      const address = copyBtn.getAttribute('data-address') || '';
      const copiedText = copyBtn.getAttribute('data-copied-text') || 'Copied!';
      const originalText = copyBtn.getAttribute('data-original-text') || 'Copy Address';
      const liveText = copyBtn.getAttribute('data-live-copied') || 'Address copied to clipboard';

      const updateSuccessState = () => {
        copyBtnText.textContent = copiedText;
        copyBtn.setAttribute('aria-label', copiedText);
        copyBtn.classList.add('bg-emerald-100', 'text-emerald-900');
        if (copyStatusLive) {
          copyStatusLive.textContent = liveText;
        }
        setTimeout(() => {
          copyBtnText.textContent = originalText;
          copyBtn.setAttribute('aria-label', originalText);
          copyBtn.classList.remove('bg-emerald-100', 'text-emerald-900');
          if (copyStatusLive) {
            copyStatusLive.textContent = '';
          }
        }, 3000);
      };

      try {
        await navigator.clipboard.writeText(address);
        updateSuccessState();
      } catch (err) {
        // Fallback
        const textarea = document.createElement('textarea');
        textarea.value = address;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        updateSuccessState();
      }
    });
  }

  // On-demand interactive map loader (FIND-2: Privacy protected, no trackers)
  const loadMapBtn = document.getElementById('load-interactive-map-btn');
  const staticMapView = document.getElementById('static-map-view');
  const interactiveMapFrame = document.getElementById('interactive-map-frame');
  const mapStatusLive = document.getElementById('map-status-live');

  if (loadMapBtn && staticMapView && interactiveMapFrame) {
    loadMapBtn.addEventListener('click', () => {
      // Coordinates: Pimlico / London (51.4882, -0.1378)
      const lat = 51.4882;
      const lon = -0.1378;
      const osmIframeUrl = `https://www.openstreetmap.org/export/embed.html?bbox=${lon - 0.005}%2C${lat - 0.003}%2C${lon + 0.005}%2C${lat + 0.003}&layer=mapnik&marker=${lat}%2C${lon}`;

      const iframe = document.createElement('iframe');
      iframe.src = osmIframeUrl;
      iframe.title = 'Felege Genet Church Location Map';
      iframe.className = 'w-full h-full border-0';
      iframe.loading = 'lazy';
      iframe.setAttribute('aria-label', 'Interactive map showing church venue');

      interactiveMapFrame.appendChild(iframe);
      staticMapView.classList.add('hidden');
      interactiveMapFrame.classList.remove('hidden');

      loadMapBtn.setAttribute('aria-expanded', 'true');
      const loadedNotice = loadMapBtn.getAttribute('data-loaded-announcement') || 'Interactive map loaded';
      if (mapStatusLive) {
        mapStatusLive.textContent = loadedNotice;
      }
    });
  }
</script>
